# The public demo works in simulation without any variables.
# Set all three only for a dedicated Pey CoDi test account.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_OPERATOR_TOKEN=
# Optional: explicitly select an active, preauthorized account in Pey.
PEY_BANK_ACCOUNT_ID=
# Optional: pick a persistent directory outside the source tree.
PEY_DATA_DIR=
